# ticketflow configuration. Every variable is read by internal/config and nowhere else.

# ── Jira ──────────────────────────────────────────────────────────────────────
JIRA_BASE_URL=https://your-org.atlassian.net
# Jira Cloud: a service account's email + API token (basic auth).
# Data Center: leave JIRA_EMAIL empty and put a personal access token here (bearer auth).
JIRA_EMAIL=ticketflow-bot@your-org.com
JIRA_API_TOKEN=
# Shared secret for POST /webhooks/jira. Either configure it as the webhook's secret
# (Jira signs with X-Hub-Signature: sha256=...) or send it in an X-Ticketflow-Token header
# from a Jira Automation "Send web request" action.
JIRA_WEBHOOK_SECRET=
# Adding this label hands a ticket to the agent. Restrict who may set it.
TICKETFLOW_TRIGGER_LABEL=agent-ready
TICKETFLOW_CLAIM_LABEL=agent-in-progress
TICKETFLOW_NEEDS_HUMAN_LABEL=agent-needs-human
# Transition (or target status) applied once the PR is open; empty skips it.
TICKETFLOW_REVIEW_TRANSITION=In Review
# Jira project -> repository. A ticket can override with a repo:<owner/name> label,
# but only to a repository listed here or in TICKETFLOW_ALLOWED_REPOS.
TICKETFLOW_PROJECT_REPOS=PROJ=your-org/your-repo
TICKETFLOW_ALLOWED_REPOS=

# ── GitHub ────────────────────────────────────────────────────────────────────
# A GitHub App installation token (preferred) or fine-grained PAT with
# contents:write and pull_requests:write on the mapped repos. Never admin, never
# workflows:write, and never a branch-protection bypass actor.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
GITHUB_HOST_URL=https://github.com
TICKETFLOW_BASE_BRANCH=
TICKETFLOW_BRANCH_PREFIX=ticketflow/
TICKETFLOW_PR_LABEL=agent-authored
TICKETFLOW_DRAFT_PRS=true
TICKETFLOW_BOT_NAME=ticketflow
TICKETFLOW_BOT_EMAIL=ticketflow@users.noreply.github.com

# ── Models (Vertex AI, via Application Default Credentials) ───────────────────
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
TICKETFLOW_PLANNER_MODEL=
TICKETFLOW_CODER_MODEL=
TICKETFLOW_REVIEWER_MODEL=

# ── Harness ───────────────────────────────────────────────────────────────────
# adk: the in-process ADK coding agent (default).
# cli: an external headless agent run in the checkout. {prompt_file}, {prompt} and
#      {workdir} are substituted. Example (Gemini CLI on Vertex AI):
#        TICKETFLOW_HARNESS_COMMAND=gemini --approval-mode=yolo --output-format=json -p {prompt}
#        TICKETFLOW_HARNESS_ENV=GOOGLE_CLOUD_PROJECT,GOOGLE_CLOUD_LOCATION,GOOGLE_GENAI_USE_VERTEXAI
TICKETFLOW_HARNESS=adk
TICKETFLOW_HARNESS_COMMAND=
# Names of variables passed through to the cli harness; nothing else is.
TICKETFLOW_HARNESS_ENV=
TICKETFLOW_HARNESS_TIMEOUT=45m

# ── Budgets ───────────────────────────────────────────────────────────────────
TICKETFLOW_MAX_ATTEMPTS=3
TICKETFLOW_MAX_REVISIONS=1
TICKETFLOW_MAX_FILES=25
TICKETFLOW_MAX_CHANGED_LINES=1500
TICKETFLOW_CHECK_TIMEOUT=20m

# ── Process ───────────────────────────────────────────────────────────────────
TICKETFLOW_WORK_ROOT=/tmp
TICKETFLOW_ADDR=:8080
TICKETFLOW_WORKERS=2
